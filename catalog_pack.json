    "books": [
      {"id": "marlya_story", "name": "История кота Марли", "author": "Misha", "type": "book", "version": "1.0", "text": "Жил-был кот Марля, шотландский вислоухий, серый, 9 лет с седовыми глазами. Он очень любил стащить сыр со стола и спать на коленях у хозяина. Однажды Марля решил помочь Мише с программированием... И с тех пор они стали лучшей командой разработчиков ShotOS!"},
      {"id": "shotos_guide", "name": "Руководство по ShotOS", "author": "Misha", "type": "book", "version": "1.0", "text": "ShotOS — это операционная система, созданная Мишей. В ней есть браузер, галерея, заметки, камера и магазин QMarket. Система написана на Flutter и Dart, а скрипты исполняются на MarlyaScript."},
      {"id": "marlyascript_syntax", "name": "Синтаксис MarlyaScript", "author": "Misha", "type": "book", "version": "1.0", "text": "MarlyaScript — легкий язык для скриптов. Переменные: St, In, By, lo, fl. Объекты: object Имя { поля }. Функции: fun Имя(параметры) {}. Комментарии: ** текст **."},
      {"id": "how_to_mod", "name": "Создание модов", "author": "Misha", "type": "book", "version": "1.0", "text": "Чтобы создать мод для ShotOS, напиши скрипт на MarlyaScript и добавь его в папку mods. Используй триггеры для автоматизации действий."},
      {"id": "qmarket_guide", "name": "QMarket для начинающих", "author": "Misha", "type": "book", "version": "1.0", "text": "QMarket — это магазин приложений, игр, скриптов, тем, триггеров и книг. Чтобы добавить свой контент, создай JSON-файл с полями id, name, author, type и другими обязательными полями."}
